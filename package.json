{
  "name": "ocf-renderer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": "./dist/browser/index.js"
  },
  "scripts": {
    "generate:types": "node scripts/generate-ocf-types.mjs",
    "prebuild": "npm run generate:types",
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "build:browser": "tsup --config tsup.browser.config.ts",
    "pretest": "npm run generate:types",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "test:browser": "node scripts/verify-browser-bundle.mjs"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@types/three": "^0.185.1",
    "jsdom": "^29.1.1",
    "json-schema-to-typescript": "^15.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
